# Editor desk pin. Choose a private pin for production. The app falls back to "tribute" when this is unset.
ADMIN_PIN=tribute

# Absolute site URL used for canonical links, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Turso Cloud database (libSQL). Both are required in production.
# The same two variables store traffic in page_views and click_events.
# Leave them unset locally and the public pages stay empty, unless you are running `next dev`,
# which previews data/demo-profiles.json and never uses that file in production.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Vercel Blob. The project injects both when a Blob store is connected.
# Uploads use the token. BLOB_STORE_ID names the store (also used with Vercel OIDC).
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=

# Local only. Never set this on Vercel. It allows `npm run db:seed` to copy fictional pages into Turso.
# ALLOW_DEMO_SEED=1
