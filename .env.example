# Editor desk pin. The app falls back to "tribute" when this is unset.
ADMIN_PIN=tribute

# Absolute site URL used for canonical links, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Turso Cloud database (libSQL). Leave both unset to keep reading data/profiles.json.
# The same two variables store traffic in page_views and click_events.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Vercel Blob read-write token for portrait, image, and video uploads.
# BLOB_READ_WRITE_TOKEN=
